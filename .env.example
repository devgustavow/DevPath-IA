# =====================================================================
# DevPath AI — variáveis de ambiente do backend
# Copie este arquivo para ".env" e preencha os valores.
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows CMD)
# =====================================================================

# Chave da API do Google Gemini.
# Pegue a sua gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# (Opcional) Modelo a usar. Padrão: gemini-2.5-flash (tem cota no free tier).
# Alternativas: gemini-2.5-pro, gemini-flash-latest, gemini-2.0-flash-lite
# Obs: gemini-2.0-flash e a série 1.5 podem não ter cota grátis em chaves novas.
GEMINI_MODEL=gemini-2.5-flash

# Segredo usado para assinar os tokens JWT do login.
# Em produção, gere um valor longo e aleatório e mantenha em segredo.
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio

# (Opcional) Porta do backend. Padrão: 3001
PORT=3001
