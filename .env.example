# =====================================================================
# DevPath AI — variáveis de ambiente do backend
# Copie este arquivo para ".env" e preencha os valores.
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows CMD)
# =====================================================================

# Chave da API do Google Gemini.
# Pegue a sua gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# (Opcional) Modelo a usar. Padrão: gemini-2.0-flash
# Alternativas: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# (Opcional) Porta do backend. Padrão: 3001
PORT=3001
